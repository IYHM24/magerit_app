generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Departamento {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  activo    Boolean   
  activos   Activo[]
}

model Tipo_Activo {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  activos   Activo[]
}

model Activo {
  id                Int         @id  @default(autoincrement())
  activo            String   
  id_tipo_activo    Int   
  tipo_activo       Tipo_Activo @relation(fields: [id_tipo_activo], references: [id])  
  valor             Int
  valoracion        String
  autenticidad      Int
  confidencialidad  Int 
  integridad        Int
  disponibilidad    Int
  trazabiliad       Int
  id_propietario    Int
  propietario       Departamento @relation(fields: [id_propietario], references: [id])
}

