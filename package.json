{
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^38.1.2",
    "prisma": "^6.16.2",
    "sqlite3": "^5.1.7"
  },
  "scripts": {
    "build:frontend": "cd src/frontend && npm install && npm run build",
    "electron": "electron src/backend/main.js",
    "run:migracion_inicial": "npx prisma migrate dev",
    "run:frontend": "cd src/frontend && pnpm run dev",
    "run:electron": "pnpm run electron",
    "run:development": "concurrently \"pnpm run:frontend\" \"pnpm run:electron\""
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "ts-node": "^10.9.2"
  },
  "prisma": {
    "seed": "ts-node ./prisma/seed.ts"
  }
}